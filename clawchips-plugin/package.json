{
  "name": "clawchips",
  "version": "0.6.0",
  "description": "OpenClaw plugin: TS routing (memory + heuristic rules), hooks, dashboard",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pack:dist": "bash ../scripts/package_dist.sh",
    "setup": "node scripts/setup.mjs"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist/",
    "dashboard/",
    "scripts/setup.mjs",
    "openclaw.plugin.json",
    "openclaw.security.json",
    "README.md",
    "clawchips_default.yaml"
  ],
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "clawchips",
    "llm-router"
  ],
  "license": "MIT",
  "peerDependencies": {
    "openclaw": ">=2025.1.0",
    "@openclaw/qqbot": ">=2026.4.1-beta.1",
    "@tencent-connect/openclaw-qqbot": ">=1.5.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    },
    "@openclaw/qqbot": {
      "optional": true
    },
    "@tencent-connect/openclaw-qqbot": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=23.5.0"
  },
  "dependencies": {
    "sqlite-vec": "^0.1.8",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
